# Copy to .streamlit/secrets.toml (never commit the real file) or paste into
# Streamlit Community Cloud → App settings → Secrets.
# Every setting is optional.

# --- AI ----------------------------------------------------------------------
# Your Gemini key. Pro users can use AI without bringing their own key.
GEMINI_API_KEY = "your-key-here"
# Max AI requests per visitor session when YOUR key is used (protects your quota).
AI_REQUESTS_PER_SESSION = 10

# --- Selling (leave PRO_ACCESS_CODES empty to unlock everything for everyone) --
# Generate codes with:  python -m auditor.licensing new-code 5
# Give the CODE to the customer, put the HASH here.
PRO_ACCESS_CODES = [
  # "sha256:0123abcd...",
]
# Your payment link (Stripe Payment Link, Lemon Squeezy, Gumroad, PayPal...).
BUY_URL = "https://buy.stripe.com/your-link"
PRICE_LABEL = "$19 / month"

# Free-plan limits
FREE_FINDINGS = 3
FREE_MAX_LINE_ITEMS = 50000

# --- Branding ------------------------------------------------------------------
CONTACT_EMAIL = "support@cloudauditor.com"
